# Copy this file to .env and fill in your values. Never commit .env.
# Any OpenAI-compatible provider works (OpenRouter, OpenAI, DeepSeek, ...).

LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini

# LLM-as-judge for evals (a different model family than the generator reduces self-preference bias)
JUDGE_MODEL=google/gemini-2.5-flash
